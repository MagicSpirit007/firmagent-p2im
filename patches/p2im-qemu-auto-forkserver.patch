+/*
+ * Firmwares without an svc 0x3f aflCall never enter startForkserver, so aflStart stays 0
+ * and AFL's fork server never runs. P2IM_AUTO_FORKSERVER_PC is an opt-in Thumb address
+ * (the reset handler or main). The first translated block that covers it calls
+ * startForkserver once. Unset, this is a no-op and does not change images that already
+ * execute svc 0x3f.
+ */
+void p2im_maybe_auto_forkserver(CPUArchState *env, target_ulong pc, target_ulong size)
+{
+    static int ready;
+    static int enabled;
+    static target_ulong want;
+
+    if (!ready) {
+        const char *text = getenv("P2IM_AUTO_FORKSERVER_PC");
+        char *end = NULL;
+        ready = 1;
+        if (text && text[0]) {
+            unsigned long value = strtoul(text, &end, 0);
+            if (end != text && value != 0) {
+                want = (target_ulong)value & ~(target_ulong)1;
+                enabled = 1;
+            }
+        }
+    }
+    if (!enabled || afl_startfs_invoked || afl_fork_child)
+        return;
+    if (size < 2)
+        size = 2;
+    if (want < pc || want >= pc + size)
+        return;
+    startForkserver(env, 0);
+}
